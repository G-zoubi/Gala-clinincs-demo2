      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Book a Consultation
          <svg class="svg-icon" style="width:18px;height:18px" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#services" class="btn btn-ghost">Explore Treatments</a>
      </div>
      <div class="hero-trust">
        <div class="item"><div class="n">12+</div><div class="l">Years of expertise</div></div>
        <div class="item"><div class="n">5,000+</div><div class="l">Happy clients</div></div>
        <div class="item"><div class="n">15+</div><div class="l">Beauty treatments</div></div>
      </div>
    </div>
    <div class="hero-visual reveal">
      <div class="hero-card-img">
        <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop" alt="Relaxed woman receiving a professional skincare treatment at Gala Clinics" />
      </div>
