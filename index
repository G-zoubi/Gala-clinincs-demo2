<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Gala Clinics — Dermatology & Medical Beauty in Amman</title>
<meta name="description" content="Gala Clinics in Amman offers laser hair removal, advanced skincare, body shaping, Botox & filler, and anti-aging face treatments. Rated 4.4★ on Google." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --primary:#EC4899;
    --on-primary:#FFFFFF;
    --secondary:#F9A8D4;
    --accent:#8B5CF6;
    --bg:#FDF2F8;
    --fg:#831843;
    --muted:#F1EEF5;
    --border:#FBCFE8;
    --ring:#EC4899;
    --ink:#3a1027;
    --soft:#9d4f76;
    --radius:22px;
    --shadow-sm:0 4px 20px rgba(131,24,67,.06);
    --shadow-md:0 18px 50px rgba(131,24,67,.10);
    --shadow-lg:0 30px 80px rgba(131,24,67,.16);
    --maxw:1200px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter',system-ui,sans-serif;
    color:var(--ink);
    background:var(--bg);
    line-height:1.65;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{font-family:'Playfair Display',Georgia,serif;color:var(--fg);font-weight:600;line-height:1.12}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .wrap{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:.78rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
    color:var(--primary);margin-bottom:18px;
  }
  .eyebrow::before{content:"";width:28px;height:1.5px;background:var(--primary);display:inline-block}

  /* ---------- Decorative blobs ---------- */
  .blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5;z-index:0;pointer-events:none}

  /* ---------- Nav ---------- */
  header.nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    transition:all .4s cubic-bezier(.4,0,.2,1);
  }
  .nav-inner{
    display:flex;align-items:center;justify-content:space-between;
    margin:16px auto;max-width:var(--maxw);width:calc(100% - 32px);
    padding:12px 14px 12px 22px;border-radius:60px;
    background:rgba(255,255,255,.55);
    backdrop-filter:blur(18px) saturate(160%);
    -webkit-backdrop-filter:blur(18px) saturate(160%);
    border:1px solid rgba(255,255,255,.6);
    box-shadow:var(--shadow-sm);
    transition:all .4s cubic-bezier(.4,0,.2,1);
  }
  header.nav.scrolled .nav-inner{background:rgba(255,255,255,.82);box-shadow:var(--shadow-md)}
  .logo{display:flex;align-items:center;gap:12px;font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:600;color:var(--fg)}
  .logo .mark{
    width:40px;height:40px;border-radius:50%;display:grid;place-items:center;flex:none;
    background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;
    font-weight:700;box-shadow:0 6px 18px rgba(236,72,153,.4)
  }
  .logo small{display:block;font-family:'Inter';font-size:.6rem;letter-spacing:.28em;color:var(--soft);font-weight:600;text-transform:uppercase;margin-top:-2px}
  .nav-links{display:flex;align-items:center;gap:6px}
  .nav-links a{padding:9px 16px;border-radius:40px;font-size:.92rem;font-weight:500;color:var(--ink);transition:all .25s}
  .nav-links a:hover{background:var(--muted);color:var(--primary)}
  .btn{
    display:inline-flex;align-items:center;gap:9px;cursor:pointer;border:none;
    font-family:inherit;font-size:.95rem;font-weight:600;
    padding:13px 26px;border-radius:40px;transition:all .3s cubic-bezier(.4,0,.2,1);
  }
  .btn-primary{
    background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;
    box-shadow:0 10px 26px rgba(236,72,153,.38)
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(236,72,153,.5)}
  .btn-ghost{background:rgba(255,255,255,.7);color:var(--fg);border:1px solid var(--border)}
  .btn-ghost:hover{background:#fff;transform:translateY(-2px);box-shadow:var(--shadow-sm)}
  .nav-cta{display:flex;align-items:center;gap:10px}
  .hamburger{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px}
  .hamburger span{width:24px;height:2px;background:var(--fg);border-radius:2px;transition:.3s}

  /* ---------- Hero ---------- */
  .hero{position:relative;padding:160px 0 90px;overflow:hidden}
  .hero .blob.b1{width:520px;height:520px;background:var(--secondary);top:-120px;right:-100px}
  .hero .blob.b2{width:440px;height:440px;background:#c4b5fd;bottom:-160px;left:-120px;opacity:.4}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center;position:relative;z-index:2}
  .pill{
    display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:40px;
    background:rgba(255,255,255,.7);border:1px solid var(--border);font-size:.82rem;font-weight:500;color:var(--soft);
    margin-bottom:24px;box-shadow:var(--shadow-sm)
  }
  .pill .stars{color:#f59e0b;letter-spacing:1px}
  .hero h1{font-size:clamp(2.6rem,5.5vw,4.4rem);margin-bottom:22px}
  .hero h1 .grad{background:linear-gradient(120deg,var(--primary),var(--accent));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;font-style:italic}
  .hero p.lead{font-size:1.18rem;color:var(--soft);max-width:520px;margin-bottom:14px}
  .hero .arabic{font-size:1.05rem;color:var(--soft);direction:rtl;margin-bottom:32px;font-weight:300}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:38px}
  .hero-trust{display:flex;gap:30px;flex-wrap:wrap}
  .hero-trust .item .n{font-family:'Playfair Display',serif;font-size:1.9rem;color:var(--fg);font-weight:600}
  .hero-trust .item .l{font-size:.82rem;color:var(--soft)}

  /* hero visual */
  .hero-visual{position:relative;height:540px}
  .hero-card-img{
    position:absolute;inset:0;border-radius:34px;overflow:hidden;
    background:linear-gradient(160deg,#fce7f3,#ede9fe);
    box-shadow:var(--shadow-lg);border:6px solid #fff;
  }
  .hero-card-img img{width:100%;height:100%;object-fit:cover}
  .glass-card{
    position:absolute;background:rgba(255,255,255,.7);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:16px 20px;box-shadow:var(--shadow-md);
    display:flex;align-items:center;gap:14px;
  }
  .glass-card .ic{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;flex:none}
  .glass-card .ti{font-weight:600;font-size:.95rem;color:var(--fg)}
  .glass-card .su{font-size:.78rem;color:var(--soft)}
  .fc1{top:34px;left:-28px;animation:float 6s ease-in-out infinite}
  .fc2{bottom:40px;right:-26px;animation:float 6s ease-in-out infinite 1.5s}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

  /* ---------- Marquee strip ---------- */
  .strip{background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;padding:18px 0;overflow:hidden;position:relative}
  .marquee{display:flex;gap:60px;white-space:nowrap;animation:scroll 26s linear infinite;font-family:'Playfair Display',serif;font-style:italic;font-size:1.25rem}
  .marquee span{display:inline-flex;align-items:center;gap:60px;opacity:.95}
  @keyframes scroll{to{transform:translateX(-50%)}}

  /* ---------- Section base ---------- */
  section{position:relative}
  .section-pad{padding:100px 0}
  .section-head{text-align:center;max-width:680px;margin:0 auto 60px}
  .section-head h2{font-size:clamp(2rem,4vw,3rem);margin-bottom:16px}
  .section-head p{color:var(--soft);font-size:1.08rem}

  /* ---------- Services ---------- */
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .service{
    background:#fff;border-radius:var(--radius);padding:34px 30px;border:1px solid var(--border);
    transition:all .4s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden;
  }
  .service::after{content:"";position:absolute;inset:0;border-radius:var(--radius);padding:1px;background:linear-gradient(135deg,var(--primary),var(--accent));-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:.4s}
  .service:hover{transform:translateY(-8px);box-shadow:var(--shadow-lg)}
  .service:hover::after{opacity:1}
  .service .ic{
    width:60px;height:60px;border-radius:18px;display:grid;place-items:center;margin-bottom:22px;
    background:linear-gradient(135deg,#fce7f3,#f3e8ff);color:var(--primary);
  }
  .service h3{font-size:1.32rem;margin-bottom:10px}
  .service p{color:var(--soft);font-size:.96rem;margin-bottom:18px}
  .service .more{font-size:.88rem;font-weight:600;color:var(--primary);display:inline-flex;align-items:center;gap:6px;transition:gap .25s}
  .service:hover .more{gap:12px}
  .svg-icon{width:30px;height:30px;stroke:currentColor;stroke-width:1.6;fill:none}

  /* ---------- About / split ---------- */
  .split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  .about-imgs{position:relative;height:520px}
  .about-imgs .a{position:absolute;border-radius:26px;overflow:hidden;box-shadow:var(--shadow-md);border:5px solid #fff}
  .about-imgs .a1{width:62%;height:72%;top:0;left:0;z-index:2}
  .about-imgs .a2{width:54%;height:58%;bottom:0;right:0;z-index:3}
  .about-imgs .badge{
    position:absolute;z-index:4;bottom:28%;left:-20px;background:#fff;border-radius:20px;padding:18px 22px;
    box-shadow:var(--shadow-lg);text-align:center;
  }
  .about-imgs .badge .n{font-family:'Playfair Display',serif;font-size:2rem;color:var(--primary);font-weight:700;line-height:1}
  .about-imgs .badge .l{font-size:.72rem;color:var(--soft);text-transform:uppercase;letter-spacing:.1em}
  .feature-list{display:grid;gap:18px;margin-top:28px}
  .feature-list li{display:flex;gap:16px;align-items:flex-start;list-style:none}
  .feature-list .chk{width:30px;height:30px;border-radius:50%;flex:none;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff}
  .feature-list b{color:var(--fg);font-weight:600;display:block}
  .feature-list span{color:var(--soft);font-size:.94rem}

  /* ---------- Stats band ---------- */
  .stats{background:linear-gradient(135deg,#fff5fb,#f5f0ff);border-radius:34px;padding:54px 40px;border:1px solid var(--border)}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;text-align:center}
  .stats .n{font-family:'Playfair Display',serif;font-size:2.8rem;color:var(--primary);font-weight:700;line-height:1}
  .stats .l{color:var(--soft);font-size:.95rem;margin-top:8px}

  /* ---------- Reviews ---------- */
  .reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .review{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow-sm);transition:.3s}
  .review:hover{box-shadow:var(--shadow-md);transform:translateY(-5px)}
  .review .stars{color:#f59e0b;letter-spacing:2px;margin-bottom:14px}
  .review p{color:var(--ink);font-size:1rem;margin-bottom:20px;font-style:italic}
  .review .who{display:flex;align-items:center;gap:12px}
  .review .av{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:600;background:linear-gradient(135deg,var(--primary),var(--accent))}
  .review .who b{color:var(--fg);font-size:.95rem;display:block}
  .review .who span{color:var(--soft);font-size:.82rem}
  .gsrc{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--border);padding:10px 22px;border-radius:40px;box-shadow:var(--shadow-sm);margin-top:40px}
  .gsrc .stars{color:#f59e0b;letter-spacing:1px}

  /* ---------- Contact ---------- */
  .contact{background:linear-gradient(160deg,#fff,#fdf2f8)}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:stretch}
  .info-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-sm)}
  .map-frame{width:100%;height:100%;min-height:340px;border:0;border-radius:16px;filter:saturate(1.05)}
  .info-row{display:flex;gap:18px;align-items:flex-start;padding:20px 14px;border-bottom:1px solid var(--muted)}
  .info-row:last-child{border-bottom:none}
  .info-row .ic{width:48px;height:48px;border-radius:14px;flex:none;display:grid;place-items:center;background:linear-gradient(135deg,#fce7f3,#ede9fe);color:var(--primary)}
  .info-row b{display:block;color:var(--fg);font-weight:600;margin-bottom:2px}
  .info-row span,.info-row a{color:var(--soft);font-size:.95rem}
  .info-row a:hover{color:var(--primary)}
  .open-tag{display:inline-block;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:600;background:#fee2e2;color:#b91c1c;margin-left:6px}

  /* booking form */
  .form-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:36px;box-shadow:var(--shadow-md)}
  .form-card h3{font-size:1.6rem;margin-bottom:6px}
  .form-card .sub{color:var(--soft);margin-bottom:24px;font-size:.95rem}
  .field{margin-bottom:18px}
  .field label{display:block;font-size:.85rem;font-weight:600;color:var(--fg);margin-bottom:7px}
  .field input,.field select,.field textarea{
    width:100%;padding:13px 16px;border-radius:14px;border:1px solid var(--border);background:#fffafd;
    font-family:inherit;font-size:.95rem;color:var(--ink);transition:.25s
  }
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 4px rgba(236,72,153,.12);background:#fff}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .form-card .btn-primary{width:100%;justify-content:center;margin-top:6px}
  .form-note{font-size:.8rem;color:var(--soft);text-align:center;margin-top:14px}
  .ok-msg{display:none;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;padding:14px;border-radius:14px;font-size:.92rem;text-align:center;margin-top:16px}

  /* ---------- CTA banner ---------- */
  .cta-banner{position:relative;overflow:hidden;border-radius:36px;padding:70px 50px;text-align:center;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;box-shadow:var(--shadow-lg)}
  .cta-banner .blob{opacity:.25}
  .cta-banner .bb1{width:340px;height:340px;background:#fff;top:-120px;left:-60px}
  .cta-banner .bb2{width:300px;height:300px;background:#fde68a;bottom:-140px;right:-40px;opacity:.3}
  .cta-banner h2{color:#fff;font-size:clamp(2rem,4vw,3rem);margin-bottom:14px;position:relative;z-index:2}
  .cta-banner p{color:rgba(255,255,255,.9);font-size:1.1rem;margin-bottom:30px;position:relative;z-index:2}
  .cta-banner .btn{position:relative;z-index:2}
  .cta-banner .btn-white{background:#fff;color:var(--primary)}
  .cta-banner .btn-white:hover{transform:translateY(-2px);box-shadow:0 16px 36px rgba(0,0,0,.18)}
  .cta-banner .btn-outline{background:transparent;border:1.5px solid rgba(255,255,255,.7);color:#fff}
  .cta-banner .btn-outline:hover{background:rgba(255,255,255,.15)}

  /* ---------- Footer ---------- */
  footer{background:#2b0a1c;color:#e9c9da;padding:70px 0 30px;margin-top:0}
  .foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:40px;margin-bottom:50px}
  footer .logo{color:#fff}
  footer .logo small{color:#c98aab}
  footer p.desc{color:#c98aab;margin-top:18px;font-size:.94rem;max-width:300px}
  footer h4{color:#fff;font-family:'Inter';font-size:.82rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:20px}
  footer ul{list-style:none;display:grid;gap:12px}
  footer ul a{color:#c98aab;font-size:.94rem;transition:.25s}
  footer ul a:hover{color:var(--secondary)}
  .socials{display:flex;gap:12px;margin-top:20px}
  .socials a{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:rgba(255,255,255,.08);color:#fff;transition:.3s}
  .socials a:hover{background:linear-gradient(135deg,var(--primary),var(--accent));transform:translateY(-3px)}
  .foot-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;color:#a86d8c;font-size:.85rem}

  /* reveal animation */
  .reveal{opacity:0;transform:translateY(34px);transition:all .8s cubic-bezier(.16,1,.3,1)}
  .reveal.in{opacity:1;transform:none}

  /* ---------- Responsive ---------- */
  @media(max-width:980px){
    .hero-grid,.split,.contact-grid{grid-template-columns:1fr;gap:40px}
    .hero-visual{height:420px;max-width:480px;margin:0 auto;width:100%}
    .services-grid,.reviews-grid{grid-template-columns:repeat(2,1fr)}
    .foot-grid{grid-template-columns:1fr 1fr}
    .about-imgs{max-width:460px;margin:0 auto;width:100%}
  }
  @media(max-width:680px){
    .nav-links{display:none}
    .hamburger{display:flex}
    .nav-cta .btn-ghost{display:none}
    .services-grid,.reviews-grid,.stats-grid,.field-row{grid-template-columns:1fr}
    .stats-grid{gap:34px}
    .foot-grid{grid-template-columns:1fr}
    .section-pad{padding:70px 0}
    .hero{padding:130px 0 70px}
    .cta-banner{padding:50px 26px}
    .nav-inner{padding:10px 12px 10px 18px}
    .mobile-menu.open{display:flex}
  }
  /* mobile menu */
  .mobile-menu{display:none;flex-direction:column;gap:6px;position:fixed;top:84px;left:16px;right:16px;z-index:99;
    background:rgba(255,255,255,.95);backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:24px;padding:18px;box-shadow:var(--shadow-lg)}
  .mobile-menu a{padding:12px 16px;border-radius:14px;font-weight:500;color:var(--ink)}
  .mobile-menu a:hover{background:var(--muted);color:var(--primary)}

  @media(prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
    .reveal{opacity:1;transform:none}
  }
</style>
</head>
<body>

<!-- ============ NAV ============ -->
<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="#home" class="logo">
      <span class="mark">G</span>
      <span>Gala Clinics<small>Dermatology · Amman</small></span>
